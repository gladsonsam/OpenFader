{
  "id": "mixer",
  "module": "row",
  "props": {
    "flex": "1 1 auto",
    "minWidth": 0,
    "minHeight": 0,
    "gap": 4
  },
  "children": [
    {
      "id": "strip-scroll",
      "module": "scroll",
      "props": {
        "direction": "row",
        "flex": "1 1 auto",
        "minWidth": 0,
        "dragScroll": true
      },
      "variants": {
        "phone": {
          "props": {
            "snap": "x"
          }
        },
        "tablet": {
          "props": {
            "snap": "x"
          }
        }
      },
      "children": [
        {
          "id": "strip-grid",
          "module": "grid",
          "props": {
            "rows": "minmax(0, 1fr)",
            "gap": 3,
            "height": "100%",
            "minWidth": 0,
            "width": "100%"
          },
          "bind": {
            "columns": "setting:gridCols"
          },
          "variants": {
            "phone": {
              "bind": {
                "columns": "phoneCols"
              },
              "props": {
                "snapItems": true
              }
            },
            "tablet": {
              "bind": {
                "columns": "tabletCols"
              },
              "props": {
                "snapItems": true
              }
            }
          },
          "children": [
            {
              "id": "strips",
              "module": "repeat",
              "props": {
                "over": "bank:visible"
              },
              "variants": {
                "phone": {
                  "props": {
                    "over": "list:allBankItems"
                  }
                }
              },
              "children": [
                {
                  "id": "strip",
                  "module": "strip-frame",
                  "bind": {
                    "cell": "item",
                    "index": "index",
                    "store": "store",
                    "frozen": "frozen",
                    "tree": "anatomy",
                    "device": "stripDevice"
                  }
                }
              ]
            },
            {
              "id": "empties",
              "module": "repeat",
              "props": {
                "over": "list:emptySlots"
              },
              "children": [
                {
                  "id": "empty",
                  "module": "strip-empty"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "master",
      "module": "col",
      "props": {
        "tag": "section",
        "label": "Master strip",
        "width": 112,
        "flex": "none",
        "gap": 3,
        "padding": 3,
        "background": "var(--u4-panel-bg)",
        "border": "1px solid var(--u4-line-panel)",
        "box": "content-box",
        "selectable": true
      },
      "variants": {
        "phone": {
          "props": {
            "width": 76
          }
        }
      },
      "bind": {
        "shadow": "master.ring"
      },
      "when": "master.id",
      "on": {
        "select": {
          "do": "ui.select",
          "args": {
            "id": {
              "$expr": "master.id"
            }
          }
        }
      },
      "children": [
        {
          "id": "master-bus",
          "module": "btn",
          "props": {
            "height": 40,
            "fontSize": 12,
            "padding": "0 8px",
            "bg": "var(--u4-master-bus-bg, #1b2330)",
            "fg": "var(--u4-master-bus-fg, #e8edf5)",
            "border": "1px solid var(--u4-master-bus-border, #3a414c)"
          },
          "when": "device != 'phone' || store.sel == master.id",
          "bind": {
            "height": "showProcessing ? 48 : 40",
            "label": "master.busLabel",
            "ariaLabel": "concat('Select master bus, current ', master.name)"
          },
          "on": {
            "press": {
              "do": "ui.openBusPopup"
            }
          }
        },
        {
          "id": "master-proc",
          "module": "col",
          "when": "showProcessing && (master.hasEq || master.hasDyn)",
          "props": {
            "flex": "none",
            "gap": 3,
            "height": 102
          },
          "children": [
            {
              "id": "master-eq-mini",
              "module": "strip-eq-mini",
              "bind": {
                "path": "master.eqPath",
                "stroke": "master.eqStroke",
                "ariaLabel": "master.eqAria"
              },
              "on": {
                "open": {
                  "do": "ui.openEq",
                  "args": {
                    "id": {
                      "$expr": "master.id"
                    }
                  }
                }
              },
              "when": "master.hasEq"
            },
            {
              "id": "master-dynamics-well",
              "module": "col",
              "when": "master.hasDyn",
              "props": {
                "height": 51,
                "flex": "none",
                "gap": 3,
                "padding": 4,
                "background": "var(--u4-well-bg)",
                "border": "1px solid var(--u4-line-panel)",
                "radius": 5
              },
              "children": [
                {
                  "id": "master-gate-mini",
                  "module": "strip-dyn-mini",
                  "props": {
                    "label": "Gate",
                    "kind": "gate"
                  },
                  "bind": {
                    "stripId": "master.id",
                    "enabled": "master.gateOn",
                    "ariaLabel": "concat('Open gate for ', master.name)"
                  },
                  "when": "master.hasDyn",
                  "on": {
                    "open": [
                      {
                        "do": "ui.select",
                        "args": {
                          "id": {
                            "$expr": "master.id"
                          }
                        }
                      },
                      {
                        "do": "ui.openPage",
                        "args": {
                          "mode": "channel"
                        }
                      },
                      {
                        "do": "ui.setTab",
                        "args": {
                          "tab": "gate"
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "master-comp-mini",
                  "module": "strip-dyn-mini",
                  "props": {
                    "label": "Compressor",
                    "kind": "comp"
                  },
                  "bind": {
                    "stripId": "master.id",
                    "enabled": "master.compOn",
                    "ariaLabel": "concat('Open compressor for ', master.name)"
                  },
                  "when": "master.hasDyn",
                  "on": {
                    "open": [
                      {
                        "do": "ui.select",
                        "args": {
                          "id": {
                            "$expr": "master.id"
                          }
                        }
                      },
                      {
                        "do": "ui.openPage",
                        "args": {
                          "mode": "channel"
                        }
                      },
                      {
                        "do": "ui.setTab",
                        "args": {
                          "tab": "comp"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "bind": {
            "height": "master.hasDyn ? (master.hasEq ? 102 : 51) : 48"
          }
        },
        {
          "id": "master-pan",
          "module": "strip-pan",
          "when": "showProcessing",
          "bind": {
            "value": "master.pan",
            "name": "master.name",
            "fine": "master.fine"
          },
          "on": {
            "input": {
              "do": "ui.setPan",
              "args": {
                "id": {
                  "$expr": "master.id"
                },
                "value": {
                  "$expr": "payload.value"
                }
              }
            }
          }
        },
        {
          "id": "master-mute",
          "module": "strip-mute",
          "props": {
            "height": 40
          },
          "variants": {
            "phone": {
              "props": {
                "height": 48
              }
            },
            "tablet": {
              "props": {
                "height": 48
              }
            }
          },
          "bind": {
            "muted": "master.muted",
            "enabled": "master.muteEnabled",
            "label": "concat('Mute ', master.name)"
          },
          "on": {
            "press": {
              "do": "ui.toggleMute",
              "args": {
                "id": {
                  "$expr": "master.id"
                }
              }
            }
          }
        },
        {
          "id": "master-fader-area",
          "module": "col",
          "props": {
            "flex": "3 1 240px",
            "minHeight": 180
          },
          "variants": {
            "phone": {
              "props": {
                "flex": "5 1 320px",
                "minHeight": 240
              }
            }
          },
          "children": [
            {
              "id": "master-fader",
              "module": "strip-fader",
              "props": {
                "variant": "master"
              },
              "variants": {
                "phone": {
                  "props": {
                    "variant": "strip"
                  },
                  "bind": {
                    "accent": "master.kind == 'sof' ? 'sof' : 'chan'",
                    "readColor": "master.kind == 'sof' ? 'var(--u4-cyan)' : 'var(--u4-text-4)'"
                  }
                }
              },
              "bind": {
                "value": "master.value",
                "dbText": "master.readout",
                "ariaLabel": "master.faderAria",
                "accent": "master.kind == 'sof' ? 'sof' : 'master'",
                "readColor": "master.readColor",
                "fine": "master.fine",
                "meter": "master.meter",
                "meterFrozen": "frozen"
              },
              "on": {
                "input": {
                  "do": "ui.setStripFader",
                  "args": {
                    "id": {
                      "$expr": "master.id"
                    },
                    "value": {
                      "$expr": "payload.value"
                    },
                    "useSend": {
                      "$expr": "false"
                    },
                    "mix": {
                      "$expr": "store.mix"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "id": "master-name",
          "module": "strip-name",
          "props": {
            "variant": "strip"
          },
          "bind": {
            "icon": "master.icon",
            "name": "master.name",
            "sub": "master.sub",
            "color": "master.color",
            "text": "master.text",
            "selectAria": "master.selectAria"
          },
          "on": {
            "select": [
              {
                "do": "ui.select",
                "args": {
                  "id": {
                    "$expr": "master.id"
                  }
                }
              },
              {
                "do": "ui.openPage",
                "args": {
                  "mode": "channel"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "phone-layer-rail",
      "module": "col",
      "when": "device == 'phone'",
      "props": {
        "width": 52,
        "flex": "none",
        "gap": 3
      },
      "children": [
        {
          "id": "phone-layer-lr",
          "module": "btn",
          "props": {
            "label": "LR",
            "height": 44,
            "flex": "1 0 44px",
            "fontSize": 12,
            "padding": "0 2px",
            "bg": "var(--u4-master-bus-bg, #1b2330)",
            "fg": "var(--u4-master-bus-fg, #e8edf5)",
            "border": "1px solid var(--u4-master-bus-border, #3a414c)"
          },
          "bind": {
            "pressed": "store.sel == master.id ? 'true' : 'false'",
            "ariaLabel": "concat('Select master, current ', master.name)"
          },
          "on": {
            "press": {
              "do": "ui.select",
              "args": {
                "id": {
                  "$expr": "master.id"
                }
              }
            }
          }
        },
        {
          "id": "phone-layer-banks",
          "module": "repeat",
          "props": {
            "over": "list:banks"
          },
          "children": [
            {
              "id": "phone-layer-bank",
              "module": "btn",
              "props": {
                "height": 44,
                "flex": "1 0 44px",
                "fontSize": 12,
                "padding": "0 2px"
              },
              "bind": {
                "label": "item.label",
                "bg": "item.key == store.bank ? item.color : 'var(--u4-bank-off)'",
                "fg": "item.key == store.bank ? item.text : 'var(--u4-text-1)'",
                "border": "'1px solid var(--u4-line-panel)'",
                "pressed": "item.key == store.bank ? 'true' : 'false'",
                "ariaLabel": "concat('Layers ', item.label)"
              },
              "on": {
                "press": {
                  "do": "ui.setBank",
                  "args": {
                    "bank": {
                      "$expr": "item.key"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
