{
  "$doc": "S910 default layout for the Scenes screen (docs/design/shots/10-scenes.png). Rendered by the generic LayoutRenderer. The scrollable card grid is a layout repeat over the scene card vms (sceneCards in scope order); the recall bar is one module bound to the recall vm. Select dispatches ui.pickScene (Instant loads immediately, Confirm previews); Cancel/Recall dispatch ui.goBack/ui.recallScene.",
  "id": "scenes-root",
  "module": "col",
  "props": { "gap": 8, "flex": 1, "minHeight": 0 },
  "children": [
    {
      "id": "scenes-scroll",
      "module": "scroll",
      "props": { "flex": 1, "minHeight": 0, "box": "content-box" },
      "children": [
        {
          "id": "scenes-grid",
          "module": "grid",
          "props": {
            "columns": "repeat(auto-fill, minmax(220px, 1fr))",
            "gap": 6,
            "box": "content-box"
          },
          "children": [
            {
              "id": "scenes-cards",
              "module": "repeat",
              "props": { "over": "list:sceneCards" },
              "children": [
                {
                  "id": "scene-card",
                  "module": "scene-card",
                  "bind": {
                    "index": "item.index",
                    "num": "item.num",
                    "name": "item.name",
                    "tag": "item.tag",
                    "pressed": "item.pressed",
                    "border": "item.border",
                    "bg": "item.bg"
                  },
                  "on": {
                    "select": {
                      "do": "ui.pickScene",
                      "args": { "index": { "$expr": "payload.index" } }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "scenes-recall",
      "module": "scene-recall-bar",
      "bind": {
        "tag": "recall.tag",
        "tagColor": "recall.tagColor",
        "num": "recall.num",
        "name": "recall.name",
        "barBorder": "recall.barBorder",
        "border": "recall.border",
        "bg": "recall.bg",
        "text": "recall.text",
        "disabled": "recall.disabled"
      },
      "on": {
        "cancel": { "do": "ui.goBack" },
        "recall": { "do": "ui.recallScene" }
      }
    }
  ]
}
