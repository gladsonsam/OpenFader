{
  "id": "channel",
  "module": "row",
  "props": {
    "gap": 6,
    "flex": "1",
    "minWidth": 0,
    "minHeight": 0,
    "box": "content-box"
  },
  "variants": {
    "phone": {
      "module": "col",
      "props": {
        "gap": 8,
        "minHeight": 0
      }
    }
  },
  "children": [
    {
      "id": "tab-list",
      "module": "col",
      "props": {
        "tag": "nav",
        "label": "Processing",
        "width": 112,
        "gap": 5,
        "flex": "none",
        "box": "content-box"
      },
      "variants": {
        "phone": {
          "module": "scroll",
          "props": {
            "direction": "row",
            "width": "100%",
            "flex": "none",
            "gap": 5,
            "snap": "x",
            "box": "content-box"
          }
        }
      },
      "children": [
        {
          "id": "tab-buttons",
          "module": "repeat",
          "props": {
            "over": "list:tabs"
          },
          "variants": {
            "phone": {
              "props": {
                "over": "list:phoneTabs"
              }
            }
          },
          "children": [
            {
              "id": "tab-button",
              "module": "channel-tab-button",
              "bind": {
                "entry": "item"
              },
              "on": {
                "pick": {
                  "do": "ui.setTab",
                  "args": {
                    "tab": {
                      "$expr": "payload.id"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "content",
      "module": "col",
      "props": {
        "tag": "main",
        "flex": "1",
        "minWidth": 0,
        "gap": 6,
        "box": "content-box",
        "overflow": "auto"
      },
      "variants": {
        "phone": {
          "props": {
            "minHeight": 0,
            "flex": "1 1 auto",
            "height": "100%"
          }
        }
      },
      "children": [
        {
          "id": "tab-input",
          "module": "col",
          "props": {
            "gap": 6,
            "flex": "1 1 auto",
            "minHeight": 0,
            "box": "content-box"
          },
          "when": "store.tab == 'input'",
          "variants": {
            "phone": {
              "props": {
                "flex": "1 1 auto",
                "minHeight": 0,
                "width": "100%"
              }
            }
          },
          "children": [
            {
              "id": "input-empty",
              "module": "col",
              "props": {
                "flex": "none",
                "align": "center",
                "justify": "center",
                "padding": 24,
                "radius": 3,
                "border": "1px solid var(--u4-line-panel)",
                "background": "var(--u4-well-bg)",
                "box": "content-box"
              },
              "when": "!inputVm.hasInput",
              "children": [
                {
                  "id": "input-empty-text",
                  "module": "text",
                  "props": {
                    "value": "No preamp on this channel \u2014 its signal comes from inside the console.",
                    "size": 15,
                    "color": "var(--u4-text-5)",
                    "align": "center"
                  }
                }
              ]
            },
            {
              "id": "input-top",
              "module": "grid",
              "props": {
                "columns": "repeat(auto-fit, minmax(270px, 1fr))",
                "gap": 8,
                "align": "stretch",
                "flex": "none",
                "box": "content-box"
              },
              "variants": {
                "phone": {
                  "props": {
                    "flex": "none",
                    "width": "100%"
                  }
                }
              },
              "children": [
            {
              "id": "input-identity",
              "module": "strip-name-editor",
              "props": {
                "inline": true
              },
              "bind": {
                "name": "cell.name",
                "selectedColor": "cell.color",
                "selectedIcon": "cell.icon"
              },
              "when": "cell != null",
              "on": {
                "rename": {
                  "do": "ui.setChannelName",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "value": {
                      "$expr": "payload.value"
                    }
                  }
                },
                "recolor": {
                  "do": "ui.setChannelColor",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "color": {
                      "$expr": "payload.color"
                    },
                    "text": {
                      "$expr": "payload.text"
                    }
                  }
                },
                "reicon": {
                  "do": "ui.setChannelIcon",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "icon": {
                      "$expr": "payload.icon"
                    }
                  }
                }
              }
            },
            {
              "id": "source",
              "module": "input-source-card",
              "bind": {
                "showMeter": "device == 'phone'",
                "vm": "inputVm",
                "levelText": "levelText",
                "meter": "hbarMeter",
                "meterFrozen": "frozen"
              },
              "when": "inputVm.hasInput",
              "on": {
                "patch": {
                  "do": "ui.goPatch",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    }
                  }
                }
              }
            },
            {
              "id": "preamp",
              "module": "input-preamp-card",
              "bind": {
                "vm": "inputVm",
                "fine": "store.fine"
              },
              "when": "inputVm.hasInput",
              "on": {
                "knob": {
                  "do": "ui.setInputKnob",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "key": {
                      "$expr": "payload.key"
                    },
                    "value": {
                      "$expr": "payload.value"
                    }
                  }
                },
                "phantom": {
                  "do": "ui.togglePhantom",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    }
                  }
                },
                "invert": {
                  "do": "ui.toggleInvert",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    }
                  }
                }
              }
            },
            {
              "id": "delay",
              "module": "input-delay-card",
              "bind": {
                "vm": "inputVm",
                "fine": "store.fine"
              },
              "when": "inputVm.hasInput",
              "on": {
                "knob": {
                  "do": "ui.setInputKnob",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "key": {
                      "$expr": "payload.key"
                    },
                    "value": {
                      "$expr": "payload.value"
                    }
                  }
                },
                "toggle": {
                  "do": "ui.toggleDelayOn",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    }
                  }
                }
              }
            },
            {
              "id": "presets",
              "module": "channel-presets-card",
              "bind": {
                "channelId": {
                  "$expr": "selId"
                }
              }
            },
            {
              "id": "input-solo",
              "module": "btn",
              "props": {
                "height": 48,
                "flex": "none",
                "label": "Solo channel"
              },
              "bind": {
                "pressed": "cell.solo ? 'true' : 'false'",
                "disabled": "!cell.soloEnabled",
                "bg": "cell.solo ? 'var(--u4-amber)' : 'var(--u4-btn-bg)'",
                "fg": "cell.solo ? '#241703' : 'var(--u4-text-1)'"
              },
              "when": "cell != null",
              "on": {
                "press": {
                  "do": "ui.toggleSolo",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    }
                  }
                }
              }
            }
              ]
            }
          ]
        },
        {
          "id": "tab-sends",
          "module": "grid",
          "props": {
            "columns": "repeat(auto-fill, minmax(320px, 1fr))",
            "gap": 6,
            "box": "content-box"
          },
          "when": "store.tab == 'sends'",
          "variants": {
            "phone": {
              "props": {
                "flex": "1 1 auto",
                "minHeight": 0,
                "width": "100%"
              }
            }
          },
          "children": [
            {
              "id": "sends-empty",
              "module": "col",
              "props": {
                "flex": "1",
                "align": "center",
                "justify": "center",
                "padding": 24,
                "radius": 3,
                "border": "1px solid var(--u4-line-panel)",
                "background": "var(--u4-well-bg)",
                "box": "content-box"
              },
              "when": "count(sendRows) == 0",
              "children": [
                {
                  "id": "sends-empty-text",
                  "module": "text",
                  "props": {
                    "value": "Buses and outputs don't send to mixes.",
                    "size": 15,
                    "color": "var(--u4-text-5)",
                    "align": "center"
                  }
                }
              ]
            },
            {
              "id": "rows",
              "module": "repeat",
              "props": {
                "over": "list:sends"
              },
              "when": "count(sendRows) > 0",
              "children": [
                {
                  "id": "row",
                  "module": "send-row",
                  "bind": {
                    "row": "item",
                    "fine": "store.fine"
                  },
                  "on": {
                    "input": {
                      "do": "ui.setSend",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "k": {
                          "$expr": "index"
                        },
                        "value": {
                          "$expr": "payload.value"
                        }
                      }
                    },
                    "togglePre": {
                      "do": "ui.toggleSendPre",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "k": {
                          "$expr": "index"
                        }
                      }
                    },
                    "toggleGrpon": {
                      "do": "ui.toggleSendGrpon",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "k": {
                          "$expr": "index"
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "tab-eq",
          "module": "col",
          "props": {
            "gap": 6,
            "flex": "1 1 auto",
            "box": "content-box"
          },
          "when": "store.tab == 'eq' && eqGraph != null",
          "variants": {
            "phone": {
              "props": {
                "flex": "1 1 auto",
                "minHeight": 0,
                "width": "100%"
              }
            }
          },
          "children": [
            {
              "id": "top",
              "module": "row",
              "props": {
                "gap": 8,
                "align": "center",
                "wrap": true,
                "box": "content-box"
              },
              "children": [
                {
                  "id": "head",
                  "module": "eq-head",
                  "bind": {
                    "label": "eqMaster.label",
                    "bg": "eqMaster.bg",
                    "fg": "eqMaster.text",
                    "pressed": "eqMaster.str",
                    "ariaLabel": "eqMaster.label == 'EQ In' ? 'EQ in' : 'EQ bypassed'",
                    "locked": "store.locked"
                  },
                  "on": {
                    "toggle": {
                      "do": "ui.toggleEqOn",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        }
                      }
                    },
                    "flat": {
                      "do": "ui.flatEq",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        }
                      }
                    },
                    "reset": {
                      "do": "ui.resetEq",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        }
                      }
                    }
                  }
                },
                {
                  "id": "summary",
                  "module": "eq-summary",
                  "bind": {
                    "text": "eqSummary"
                  }
                }
              ]
            },
            {
              "id": "graph",
              "module": "eq-graph",
              "bind": {
                "graph": "eqGraph",
                "locked": "store.locked",
                "fine": "store.fine",
                "selBand": "store.selBand",
                "selQ": "eqSelQ"
              },
              "variants": {
                "phone": {
                  "props": {
                    "minH": 220
                  }
                }
              },
              "on": {
                "select": {
                  "do": "ui.setSelBand",
                  "args": {
                    "band": {
                      "$expr": "payload.band"
                    }
                  }
                },
                "node": {
                  "do": "channel.eqNode",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "band": {
                      "$expr": "payload.band"
                    },
                    "f": {
                      "$expr": "payload.f"
                    },
                    "g": {
                      "$expr": "payload.g"
                    },
                    "locked": {
                      "$expr": "store.locked"
                    }
                  }
                },
                "q": {
                  "do": "ui.setEqParam",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "band": {
                      "$expr": "payload.band"
                    },
                    "param": "q",
                    "value": {
                      "$expr": "payload.q"
                    }
                  }
                }
              }
            },
            {
              "id": "cards",
              "module": "grid",
              "props": {
                "columns": "repeat(auto-fit, minmax(180px, 1fr))",
                "gap": 6,
                "box": "content-box"
              },
              "variants": {
                "phone": {
                  "props": {
                    "columns": "repeat(auto-fit, minmax(160px, 1fr))"
                  }
                }
              },
              "children": [
                {
                  "id": "hpf",
                  "module": "eq-hpf-card",
                  "bind": {
                    "hpf": "eqHpf",
                    "fine": "store.fine",
                    "locked": "store.locked"
                  },
                  "on": {
                    "select": {
                      "do": "ui.setSelBand",
                      "args": {
                        "band": 0
                      }
                    },
                    "toggle": {
                      "do": "ui.toggleEqBand",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "band": 0
                      }
                    },
                    "slope": {
                      "do": "ui.setHpfSlope",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "slope": {
                          "$expr": "payload.slope"
                        }
                      }
                    },
                    "freq": {
                      "do": "ui.setEqParam",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "band": 0,
                        "param": "f",
                        "value": {
                          "$expr": "payload.value"
                        }
                      }
                    }
                  }
                },
                {
                  "id": "bands",
                  "module": "repeat",
                  "props": {
                    "over": "list:eqBands"
                  },
                  "children": [
                    {
                      "id": "band",
                      "module": "eq-band-card",
                      "bind": {
                        "card": "item",
                        "fine": "store.fine",
                        "locked": "store.locked"
                      },
                      "on": {
                        "select": {
                          "do": "ui.setSelBand",
                          "args": {
                            "band": {
                              "$expr": "payload.band"
                            }
                          }
                        },
                        "toggle": {
                          "do": "ui.toggleEqBand",
                          "args": {
                            "id": {
                              "$expr": "selId"
                            },
                            "band": {
                              "$expr": "payload.band"
                            }
                          }
                        },
                        "type": {
                          "do": "ui.setEqBandType",
                          "args": {
                            "id": {
                              "$expr": "selId"
                            },
                            "band": {
                              "$expr": "payload.band"
                            },
                            "type": {
                              "$expr": "payload.type"
                            }
                          }
                        },
                        "param": {
                          "do": "ui.setEqParam",
                          "args": {
                            "id": {
                              "$expr": "selId"
                            },
                            "band": {
                              "$expr": "payload.band"
                            },
                            "param": {
                              "$expr": "payload.param"
                            },
                            "value": {
                              "$expr": "payload.value"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tab-gate",
          "module": "col",
          "props": {
            "gap": 6,
            "flex": "1 1 auto",
            "box": "content-box"
          },
          "when": "store.tab == 'gate'",
          "variants": {
            "phone": {
              "props": {
                "flex": "1 1 auto",
                "minHeight": 0,
                "width": "100%"
              }
            }
          },
          "children": [
            {
              "id": "head",
              "module": "dyn-summary",
              "props": {
                "kind": "gate"
              },
              "variants": {
                "phone": {
                  "props": {
                    "compact": true
                  }
                }
              },
              "bind": {
                "label": "dynLabel",
                "bg": "dynBg",
                "fg": "dynFg",
                "pressed": "dynPressed",
                "summary": "dynSummary",
                "locked": "store.locked"
              },
              "on": {
                "toggle": {
                  "do": "ui.toggleDyn",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "which": {
                      "$expr": "dynKind"
                    }
                  }
                },
                "reset": {
                  "do": "ui.resetDyn",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "which": {
                      "$expr": "dynKind"
                    }
                  }
                }
              },
              "when": "dynParams != null"
            },
            {
              "id": "body",
              "module": "row",
              "props": {
                "gap": 6,
                "wrap": true,
                "flex": "1 1 auto",
                "minHeight": 0,
                "box": "content-box"
              },
              "variants": {
                "phone": {
                  "module": "col",
                  "props": {
                    "gap": 6,
                    "flex": "1 1 auto",
                    "minHeight": 0,
                    "width": "100%",
                    "box": "content-box"
                  }
                }
              },
              "children": [
                {
                  "id": "graph",
                  "module": "dyn-transfer-graph",
                  "props": {
                    "kind": "gate",
                    "color": "#3ed0e0"
                  },
                  "variants": {
                    "phone": {
                      "props": {
                        "minH": 220,
                        "flex": "none",
                        "width": "100%",
                        "plotMR": 24
                      }
                    }
                  },
                  "on": {
                    "thr": {
                      "do": "channel.dynKnob",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "which": {
                          "$expr": "dynKind"
                        },
                        "prop": "thr",
                        "value": {
                          "$expr": "payload.value"
                        },
                        "locked": {
                          "$expr": "store.locked"
                        }
                      }
                    }
                  },
                  "bind": {
                    "aria": "dynAria",
                    "path": "dynPath",
                    "fill": "dynFill",
                    "fillColor": "dynFillColor",
                    "thrX": "dynThrX",
                    "thrLeft": "dynThrLeft",
                    "thrText": "dynThrText",
                    "grid": "dynGrid",
                    "axis": "dynAxis",
                    "params": "dynParams",
                    "frozen": "frozen",
                    "staticDotL": "dynDotL",
                    "staticDotT": "dynDotT",
                    "getLevel": "dynGetLevel",
                    "getReduction": "dynGetReduction"
                  }
                },
                {
                  "id": "knobs",
                  "module": "dyn-knob-panel",
                  "props": {
                    "kind": "gate",
                    "color": "#3ed0e0",
                    "size": 104
                  },
                  "variants": {
                    "tablet": {
                      "props": {
                        "size": 88
                      }
                    },
                    "phone": {
                      "props": {
                        "size": 76
                      }
                    }
                  },
                  "bind": {
                    "knobs": "dynKnobs",
                    "gate": "dynGate",
                    "comp": "dynComp",
                    "fine": "store.fine",
                    "locked": "store.locked"
                  },
                  "on": {
                    "knob": {
                      "do": "channel.dynKnob",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "which": {
                          "$expr": "dynKind"
                        },
                        "prop": {
                          "$expr": "payload.prop"
                        },
                        "value": {
                          "$expr": "payload.value"
                        },
                        "locked": {
                          "$expr": "store.locked"
                        }
                      }
                    }
                  }
                }
              ],
              "when": "dynParams != null"
            },
            {
              "id": "dyn-empty",
              "module": "col",
              "props": {
                "flex": "1 1 auto",
                "align": "center",
                "justify": "center",
                "padding": 24,
                "radius": 3,
                "border": "1px solid var(--u4-line-panel)",
                "background": "var(--u4-well-bg)",
                "box": "content-box"
              },
              "when": "dynParams == null",
              "children": [
                {
                  "id": "dyn-empty-text",
                  "module": "text",
                  "props": {
                    "value": "No dynamics on this channel.",
                    "size": 15,
                    "color": "var(--u4-text-5)",
                    "align": "center"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "tab-comp",
          "module": "col",
          "props": {
            "gap": 6,
            "flex": "1 1 auto",
            "box": "content-box"
          },
          "when": "store.tab == 'comp'",
          "variants": {
            "phone": {
              "props": {
                "flex": "1 1 auto",
                "minHeight": 0,
                "width": "100%"
              }
            }
          },
          "children": [
            {
              "id": "head",
              "module": "dyn-summary",
              "props": {
                "kind": "comp"
              },
              "variants": {
                "phone": {
                  "props": {
                    "compact": true
                  }
                }
              },
              "bind": {
                "label": "dynLabel",
                "bg": "dynBg",
                "fg": "dynFg",
                "pressed": "dynPressed",
                "summary": "dynSummary",
                "locked": "store.locked"
              },
              "on": {
                "toggle": {
                  "do": "ui.toggleDyn",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "which": {
                      "$expr": "dynKind"
                    }
                  }
                },
                "reset": {
                  "do": "ui.resetDyn",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "which": {
                      "$expr": "dynKind"
                    }
                  }
                }
              },
              "when": "dynParams != null"
            },
            {
              "id": "body",
              "module": "row",
              "props": {
                "gap": 6,
                "wrap": true,
                "flex": "1 1 auto",
                "minHeight": 0,
                "box": "content-box"
              },
              "variants": {
                "phone": {
                  "module": "col",
                  "props": {
                    "gap": 6,
                    "flex": "1 1 auto",
                    "minHeight": 0,
                    "width": "100%",
                    "box": "content-box"
                  }
                }
              },
              "children": [
                {
                  "id": "graph",
                  "module": "dyn-transfer-graph",
                  "props": {
                    "kind": "comp",
                    "color": "#ff9f43"
                  },
                  "variants": {
                    "phone": {
                      "props": {
                        "minH": 220,
                        "flex": "none",
                        "width": "100%",
                        "plotMR": 24
                      }
                    }
                  },
                  "on": {
                    "thr": {
                      "do": "channel.dynKnob",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "which": {
                          "$expr": "dynKind"
                        },
                        "prop": "thr",
                        "value": {
                          "$expr": "payload.value"
                        },
                        "locked": {
                          "$expr": "store.locked"
                        }
                      }
                    },
                    "ratio": {
                      "do": "channel.dynKnob",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "which": {
                          "$expr": "dynKind"
                        },
                        "prop": "ratio",
                        "value": {
                          "$expr": "payload.value"
                        },
                        "locked": {
                          "$expr": "store.locked"
                        }
                      }
                    },
                    "makeup": {
                      "do": "channel.dynKnob",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "which": {
                          "$expr": "dynKind"
                        },
                        "prop": "makeup",
                        "value": {
                          "$expr": "payload.value"
                        },
                        "locked": {
                          "$expr": "store.locked"
                        }
                      }
                    }
                  },
                  "bind": {
                    "aria": "dynAria",
                    "path": "dynPath",
                    "fill": "dynFill",
                    "fillColor": "dynFillColor",
                    "thrX": "dynThrX",
                    "thrLeft": "dynThrLeft",
                    "thrText": "dynThrText",
                    "grid": "dynGrid",
                    "axis": "dynAxis",
                    "params": "dynParams",
                    "frozen": "frozen",
                    "staticDotL": "dynDotL",
                    "staticDotT": "dynDotT",
                    "getLevel": "dynGetLevel",
                    "getReduction": "dynGetReduction"
                  }
                },
                {
                  "id": "knobs",
                  "module": "dyn-knob-panel",
                  "props": {
                    "kind": "comp",
                    "color": "#ff9f43",
                    "size": 104
                  },
                  "variants": {
                    "tablet": {
                      "props": {
                        "size": 88
                      }
                    },
                    "phone": {
                      "props": {
                        "size": 76
                      }
                    }
                  },
                  "bind": {
                    "knobs": "dynKnobs",
                    "gate": "dynGate",
                    "comp": "dynComp",
                    "fine": "store.fine",
                    "locked": "store.locked"
                  },
                  "on": {
                    "knob": {
                      "do": "channel.dynKnob",
                      "args": {
                        "id": {
                          "$expr": "selId"
                        },
                        "which": {
                          "$expr": "dynKind"
                        },
                        "prop": {
                          "$expr": "payload.prop"
                        },
                        "value": {
                          "$expr": "payload.value"
                        },
                        "locked": {
                          "$expr": "store.locked"
                        }
                      }
                    }
                  }
                }
              ],
              "when": "dynParams != null"
            },
            {
              "id": "dyn-empty",
              "module": "col",
              "props": {
                "flex": "1 1 auto",
                "align": "center",
                "justify": "center",
                "padding": 24,
                "radius": 3,
                "border": "1px solid var(--u4-line-panel)",
                "background": "var(--u4-well-bg)",
                "box": "content-box"
              },
              "when": "dynParams == null",
              "children": [
                {
                  "id": "dyn-empty-text",
                  "module": "text",
                  "props": {
                    "value": "No dynamics on this channel.",
                    "size": 15,
                    "color": "var(--u4-text-5)",
                    "align": "center"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "tab-groups",
          "module": "col",
          "props": {
            "gap": 6,
            "flex": "1 1 auto",
            "box": "content-box"
          },
          "when": "store.tab == 'groups'",
          "variants": {
            "phone": {
              "props": {
                "flex": "1 1 auto",
                "minHeight": 0,
                "width": "100%"
              }
            }
          },
          "children": [
            {
              "id": "g-src",
              "module": "channel-source-label",
              "bind": {
                "src": "master.src"
              }
            },
            {
              "id": "g-state",
              "module": "strip-state-icons",
              "bind": {
                "desk": "selState"
              },
              "when": "selState != null"
            },
            {
              "id": "g-groups",
              "module": "channel-groups-card",
              "bind": {
                "showPan": "device == 'phone'",
                "vm": "groupsVm",
                "getGr": "assignGr"
              },
              "when": "groupsVm != null",
              "on": {
                "assign": {
                  "do": "ui.setGroupAssign",
                  "args": {
                    "kind": {
                      "$expr": "payload.kind"
                    },
                    "id": {
                      "$expr": "selId"
                    },
                    "group": {
                      "$expr": "payload.group"
                    },
                    "member": {
                      "$expr": "payload.member"
                    }
                  }
                },
                "master": {
                  "do": "ui.setGroupMute",
                  "args": {
                    "kind": {
                      "$expr": "payload.kind"
                    },
                    "group": {
                      "$expr": "payload.group"
                    },
                    "muted": {
                      "$expr": "payload.muted"
                    }
                  }
                },
                "dca": {
                  "do": "ui.setDcaAssign",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "group": {
                      "$expr": "payload.group"
                    },
                    "member": {
                      "$expr": "payload.member"
                    }
                  }
                },
                "lr": {
                  "do": "ui.setLrAssign",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "assigned": {
                      "$expr": "payload.assigned"
                    }
                  }
                },
                "pan": {
                  "do": "ui.setPan",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "value": {
                      "$expr": "payload.value"
                    }
                  }
                },
                "automix": {
                  "do": "ui.setAutomixWeight",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "value": {
                      "$expr": "payload.value"
                    }
                  }
                },
                "automixOn": {
                  "do": "ui.setAutomixOn",
                  "args": {
                    "id": {
                      "$expr": "selId"
                    },
                    "on": {
                      "$expr": "payload.on"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "master",
      "module": "col",
      "when": "device != 'phone'",
      "props": {
        "tag": "aside",
        "label": "Channel strip",
        "minHeight": 0,
        "width": 136,
        "gap": 5,
        "padding": 5,
        "radius": 0,
        "background": "var(--u4-panel-bg)",
        "flex": "none",
        "box": "content-box"
      },
      "children": [
        {
          "id": "strip",
          "module": "strip-frame",
          "bind": {
            "cell": "cell",
            "store": "store",
            "frozen": "frozen",
            "tree": "anatomy",
            "device": "stripDevice"
          }
        }
      ]
    }
  ]
}
