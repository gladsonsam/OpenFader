{
  "id": "shell",
  "module": "col",
  "props": { "gap": 0 },
  "children": [
    { "id": "shell-header", "module": "header-bar" },
    {
      "id": "shell-body",
      "module": "row",
      "props": { "gap": 4, "padding": 4, "flex": 1 },
      "children": [
        { "id": "shell-content", "module": "stack", "slot": "screen", "props": { "flex": 1 } },
        { "id": "shell-rail", "module": "bank-rail", "bind": "bank", "when": { "mode": "mixer" } }
      ]
    }
  ]
}
