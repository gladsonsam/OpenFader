{
  "id": "routing",
  "module": "col",
  "props": {
    "gap": 6,
    "flex": "1 1 auto",
    "minWidth": 0,
    "minHeight": 0
  },
  "children": [
    {
      "id": "patchbay",
      "module": "col",
      "props": {
        "tag": "section",
        "label": "Patchbay",
        "gap": 10,
        "padding": 12,
        "radius": 3,
        "border": "1px solid var(--u4-line-panel)",
        "background": "var(--u4-panel-bg)",
        "flex": "1 1 auto",
        "minWidth": 0,
        "minHeight": 0,
        "box": "content-box"
      },
      "children": [
        {
          "id": "mx-head",
          "module": "row",
          "props": {
            "align": "center",
            "wrap": true,
            "gap": 8,
            "box": "content-box"
          },
          "children": [
            {
              "id": "mx-groups",
              "module": "repeat",
              "props": {
                "over": "list:routeGroups"
              },
              "children": [
                {
                  "id": "mx-group",
                  "module": "btn",
                  "props": {
                    "height": 48,
                    "fontSize": 15,
                    "border": "1px solid var(--u4-line-ctl)",
                    "bare": true
                  },
                  "bind": {
                    "label": "item.label",
                    "bg": "item.bg",
                    "fg": "item.fg",
                    "pressed": "item.pressed ? 'true' : 'false'"
                  },
                  "on": {
                    "press": {
                      "do": "ui.setPatchGroup",
                      "args": {
                        "group": {
                          "$expr": "item.key"
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "id": "mx-presets",
              "module": "row",
              "props": {
                "align": "center",
                "gap": 8,
                "margin": "0 0 0 auto",
                "box": "content-box"
              },
              "children": [
                {
                  "id": "mx-preset",
                  "module": "btn",
                  "props": {
                    "label": "1:1",
                    "height": 48,
                    "fontSize": 15,
                    "bg": "var(--u4-btn-bg)",
                    "fg": "var(--u4-text-1)",
                    "border": "1px solid var(--u4-line-ctl)",
                    "bare": true
                  },
                  "on": {
                    "press": {
                      "do": "ui.stagePreset",
                      "args": {
                        "kind": "oneToOne",
                        "group": {
                          "$expr": "store.patchGroup"
                        }
                      }
                    }
                  }
                },
                {
                  "id": "mx-clear",
                  "module": "btn",
                  "props": {
                    "label": "Clear",
                    "height": 48,
                    "fontSize": 15,
                    "bg": "#2a0d0e",
                    "fg": "#f2d6d6",
                    "border": "1px solid #6a1b1e",
                    "bare": true
                  },
                  "on": {
                    "press": {
                      "do": "ui.stagePreset",
                      "args": {
                        "kind": "clear",
                        "group": {
                          "$expr": "store.patchGroup"
                        }
                      }
                    }
                  }
                },
                {
                  "id": "mx-apply",
                  "module": "btn",
                  "props": {
                    "label": "Apply",
                    "height": 48,
                    "fontSize": 15,
                    "bg": "var(--u4-apply-bg)",
                    "fg": "var(--u4-apply-fg)",
                    "border": "1px solid var(--u4-apply-border)",
                    "bare": true
                  },
                  "when": "store.pendingPatch != null",
                  "on": {
                    "press": {
                      "do": "ui.applyPatch"
                    }
                  }
                },
                {
                  "id": "mx-cancel",
                  "module": "btn",
                  "props": {
                    "label": "Cancel",
                    "height": 48,
                    "fontSize": 15,
                    "bg": "var(--u4-btn-bg)",
                    "fg": "var(--u4-text-4)",
                    "border": "1px solid var(--u4-line-ctl)",
                    "bare": true
                  },
                  "when": "store.pendingPatch != null",
                  "on": {
                    "press": {
                      "do": "ui.cancelPatch"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "mx-scroll",
          "module": "scroll",
          "when": "device != 'phone'",
          "props": {
            "direction": "row",
            "flex": "1 1 auto",
            "minWidth": 0,
            "minHeight": 0,
            "dragScroll": true
          },
          "children": [
            {
              "id": "mx-matrix",
              "module": "route-matrix",
              "props": {
                "cell": 68,
                "headW": 220
              },
              "variants": {
                "tablet": { "props": { "cell": 54, "headW": 160 } },
                "phone": { "props": { "cell": 44, "headW": 120 } }
              },
              "bind": {
                "rows": "routing.matrix.rows",
                "cols": "routing.matrix.cols",
                "used": "routing.matrix.used",
                "pending": "routing.matrix.pending"
              },
              "on": {
                "press": {
                  "do": "ui.toggleRoute",
                  "args": {
                    "id": {
                      "$expr": "payload.rowId"
                    },
                    "label": {
                      "$expr": "payload.col"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "id": "mx-phone",
          "module": "scroll",
          "when": "device == 'phone'",
          "props": {
            "flex": "1 1 auto",
            "minWidth": 0,
            "minHeight": 0,
            "box": "content-box"
          },
          "children": [
            {
              "id": "mx-phone-col",
              "module": "col",
              "props": {
                "gap": 10,
                "box": "content-box"
              },
              "children": [
                {
                  "id": "mxp-bank-label",
                  "module": "text",
                  "props": {
                    "value": "Channels",
                    "size": 13,
                    "weight": 700,
                    "color": "var(--u4-text-6)"
                  }
                },
                {
                  "id": "mxp-banks",
                  "module": "grid",
                  "props": {
                    "columns": "repeat(3, 1fr)",
                    "gap": 8,
                    "box": "content-box"
                  },
                  "children": [
                    {
                      "id": "mxp-bank-rep",
                      "module": "repeat",
                      "props": {
                        "over": "list:routeBanks"
                      },
                      "children": [
                        {
                          "id": "mxp-bank",
                          "module": "btn",
                          "props": {
                            "height": 48,
                            "fontSize": 15,
                            "border": "1px solid var(--u4-line-ctl)",
                            "bare": true
                          },
                          "bind": {
                            "label": "item.label",
                            "bg": "item.bg",
                            "fg": "item.fg",
                            "pressed": "item.pressed ? 'true' : 'false'"
                          },
                          "on": {
                            "press": {
                              "do": "ui.setRouteBank",
                              "args": {
                                "bank": {
                                  "$expr": "item.index"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "mxp-tiles",
                  "module": "grid",
                  "props": {
                    "columns": "repeat(auto-fill, minmax(104px, 1fr))",
                    "gap": 6,
                    "box": "content-box"
                  },
                  "children": [
                    {
                      "id": "mxp-tile-rep",
                      "module": "repeat",
                      "props": {
                        "over": "list:routeTiles"
                      },
                      "children": [
                        {
                          "id": "mxp-tile",
                          "module": "route-tile",
                          "bind": {
                            "name": "item.name",
                            "src": "item.src",
                            "srcColor": "item.srcColor",
                            "pressed": "item.pressed ? 'true' : 'false'",
                            "border": "item.border",
                            "bg": "item.bg"
                          },
                          "on": {
                            "press": {
                              "do": "ui.setPatchSel",
                              "args": {
                                "id": {
                                  "$expr": "item.id"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "mxp-selrow",
                  "module": "row",
                  "props": {
                    "align": "center",
                    "gap": 8,
                    "box": "content-box"
                  },
                  "children": [
                    {
                      "id": "mxp-sel",
                      "module": "text",
                      "props": {
                        "size": 15,
                        "weight": 600,
                        "color": "var(--u4-text-1)"
                      },
                      "bind": {
                        "value": "'Patching ' + routing.selName"
                      }
                    },
                    {
                      "id": "mxp-unpatch",
                      "module": "btn",
                      "props": {
                        "label": "Unpatch",
                        "height": 48,
                        "fontSize": 15,
                        "bg": "#2a0d0e",
                        "fg": "#f2d6d6",
                        "border": "1px solid #6a1b1e",
                        "bare": true
                      },
                      "on": {
                        "press": {
                          "do": "ui.unpatch"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "mxp-src-label",
                  "module": "text",
                  "props": {
                    "value": "Sources — tap to patch",
                    "size": 13,
                    "weight": 700,
                    "color": "var(--u4-text-6)"
                  }
                },
                {
                  "id": "mxp-srcs",
                  "module": "grid",
                  "props": {
                    "columns": "repeat(auto-fill, minmax(88px, 1fr))",
                    "gap": 6,
                    "box": "content-box"
                  },
                  "children": [
                    {
                      "id": "mxp-src-rep",
                      "module": "repeat",
                      "props": {
                        "over": "list:srcTiles"
                      },
                      "children": [
                        {
                          "id": "mxp-src",
                          "module": "src-tile",
                          "bind": {
                            "label": "item.label",
                            "used": "item.used",
                            "pressed": "item.pressed ? 'true' : 'false'",
                            "bg": "item.bg",
                            "fg": "item.fg",
                            "border": "item.border"
                          },
                          "on": {
                            "press": {
                              "do": "ui.patchSrc",
                              "args": {
                                "label": {
                                  "$expr": "item.label"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
