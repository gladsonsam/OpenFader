{
  "id": "routing",
  "module": "col",
  "props": {
    "gap": 6,
    "flex": "1 1 auto",
    "minWidth": 0,
    "minHeight": 0
  },
  "children": [
    {
      "id": "patchbay",
      "module": "col",
      "props": {
        "tag": "section",
        "label": "Patchbay",
        "gap": 10,
        "padding": 12,
        "radius": 3,
        "border": "1px solid #1f2836",
        "background": "#0e1520",
        "flex": "1 1 auto",
        "minWidth": 0,
        "minHeight": 0,
        "box": "content-box"
      },
      "children": [
        {
          "id": "mx-head",
          "module": "row",
          "props": {
            "align": "center",
            "wrap": true,
            "gap": 8,
            "box": "content-box"
          },
          "children": [
            {
              "id": "mx-preset",
              "module": "btn",
              "props": {
                "label": "1:1",
                "height": 48,
                "fontSize": 15,
                "bg": "#2b3038",
                "fg": "#e8edf5",
                "border": "1px solid #3a414c",
                "bare": true
              },
              "bind": {
                "pressed": "store.pendingPatch != null && store.pendingPatch.kind == 'oneToOne' ? 'true' : 'false'"
              },
              "on": {
                "press": {
                  "do": "ui.armPatch",
                  "args": {
                    "kind": "oneToOne",
                    "group": {
                      "$expr": "store.patchGroup"
                    }
                  }
                }
              }
            },
            {
              "id": "mx-clear",
              "module": "btn",
              "props": {
                "label": "Clear",
                "height": 48,
                "fontSize": 15,
                "bg": "#2a0d0e",
                "fg": "#f2d6d6",
                "border": "1px solid #6a1b1e",
                "bare": true
              },
              "bind": {
                "pressed": "store.pendingPatch != null && store.pendingPatch.kind == 'clear' ? 'true' : 'false'"
              },
              "on": {
                "press": {
                  "do": "ui.armPatch",
                  "args": {
                    "kind": "clear",
                    "group": {
                      "$expr": "store.patchGroup"
                    }
                  }
                }
              }
            },
            {
              "id": "mx-apply",
              "module": "btn",
              "props": {
                "label": "Apply",
                "height": 48,
                "fontSize": 15,
                "bg": "#0f2e1d",
                "fg": "#7dffa8",
                "border": "1px solid #1f7a3d",
                "bare": true
              },
              "when": "store.pendingPatch != null",
              "on": {
                "press": {
                  "do": "ui.applyPatch"
                }
              }
            },
            {
              "id": "mx-cancel",
              "module": "btn",
              "props": {
                "label": "Cancel",
                "height": 48,
                "fontSize": 15,
                "bg": "#2b3038",
                "fg": "#c9d1dc",
                "border": "1px solid #3a414c",
                "bare": true
              },
              "when": "store.pendingPatch != null",
              "on": {
                "press": {
                  "do": "ui.cancelPatch"
                }
              }
            },
            {
              "id": "mx-groups",
              "module": "repeat",
              "props": {
                "over": "list:routeGroups"
              },
              "children": [
                {
                  "id": "mx-group",
                  "module": "btn",
                  "props": {
                    "height": 48,
                    "fontSize": 15,
                    "border": "1px solid #3a414c",
                    "bare": true
                  },
                  "bind": {
                    "label": "item.label",
                    "bg": "item.bg",
                    "fg": "item.fg",
                    "pressed": "item.pressed ? 'true' : 'false'"
                  },
                  "on": {
                    "press": {
                      "do": "ui.setPatchGroup",
                      "args": {
                        "group": {
                          "$expr": "item.key"
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "mx-scroll",
          "module": "scroll",
          "props": {
            "direction": "row",
            "flex": "1 1 auto",
            "minWidth": 0,
            "minHeight": 0,
            "dragScroll": true
          },
          "children": [
            {
              "id": "mx-matrix",
              "module": "route-matrix",
              "props": {
                "cell": 68,
                "headW": 220
              },
              "variants": {
                "tablet": { "props": { "cell": 54, "headW": 160 } },
                "phone": { "props": { "cell": 44, "headW": 120 } }
              },
              "bind": {
                "rows": "routing.matrix.rows",
                "cols": "routing.matrix.cols",
                "used": "routing.matrix.used"
              },
              "on": {
                "press": {
                  "do": "ui.toggleRoute",
                  "args": {
                    "id": {
                      "$expr": "payload.rowId"
                    },
                    "label": {
                      "$expr": "payload.col"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
