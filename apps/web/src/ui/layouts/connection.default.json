{
  "id": "connection",
  "module": "col",
  "props": {
    "gap": 10,
    "width": "100%",
    "maxWidth": 860,
    "margin": "0 auto",
    "box": "content-box"
  },
  "children": [
    {
      "id": "status",
      "module": "row",
      "props": {
        "tag": "section",
        "label": "Connection status",
        "align": "center",
        "wrap": true,
        "gap": 14,
        "padding": 18,
        "radius": 3,
        "background": "var(--u4-panel-bg)",
        "box": "content-box"
      },
      "bind": {
        "border": "'1px solid ' + conn.cardBorder"
      },
      "children": [
        {
          "id": "dot",
          "module": "status-dot",
          "bind": {
            "color": "conn.dot",
            "halo": "conn.halo"
          }
        },
        {
          "id": "status-text",
          "module": "col",
          "props": {
            "flex": "1",
            "minWidth": 200,
            "box": "content-box"
          },
          "children": [
            {
              "id": "status-title",
              "module": "text",
              "props": {
                "size": 22,
                "weight": 600
              },
              "bind": {
                "value": "conn.title"
              }
            },
            {
              "id": "status-sub",
              "module": "text",
              "props": {
                "size": 13,
                "color": "var(--u4-text-5)",
                "margin": "2px 0 0 0"
              },
              "bind": {
                "value": "conn.sub"
              }
            }
          ]
        },
        {
          "id": "disconnect",
          "module": "btn",
          "props": {
            "label": "Disconnect",
            "height": 46,
            "fontSize": 14,
            "padding": "0 18px",
            "bg": "var(--u4-btn-bg)",
            "fg": "var(--u4-text-1)",
            "border": "1px solid var(--u4-line-ctl)",
            "bare": true
          },
          "when": "conn.isConnected",
          "on": {
            "press": {
              "do": "ui.disconnect"
            }
          }
        }
      ]
    },
    {
      "id": "dev-head",
      "module": "row",
      "props": {
        "align": "center",
        "gap": 8,
        "margin": "6px 0 0 0",
        "box": "content-box"
      },
      "children": [
        {
          "id": "dev-label",
          "module": "text",
          "props": {
            "tag": "span",
            "value": "Devices on this network",
            "size": 12,
            "color": "var(--u4-text-6)",
            "margin": "0 auto 0 0"
          }
        },
        {
          "id": "dev-scan-label",
          "module": "text",
          "props": {
            "size": 13,
            "color": "var(--u4-text-7)"
          },
          "bind": {
            "value": "conn.lastScan"
          }
        },
        {
          "id": "scan",
          "module": "btn",
          "props": {
            "label": "Scan",
            "height": 40,
            "fontSize": 14,
            "padding": "0 14px",
            "bg": "var(--u4-btn-bg)",
            "fg": "var(--u4-text-1)",
            "border": "1px solid var(--u4-line-ctl)",
            "bare": true
          },
          "bind": {
            "label": "conn.scanLabel",
            "disabled": "conn.scanBusy"
          },
          "on": {
            "press": {
              "do": "ui.scan"
            }
          }
        }
      ]
    },
    {
      "id": "dev-rows",
      "module": "repeat",
      "props": {
        "over": "list:devices"
      },
      "children": [
        {
          "id": "dev-row",
          "module": "device-row",
          "bind": {
            "device": "item"
          },
          "on": {
            "connect": {
              "do": "ui.connect",
              "args": {
                "key": {
                  "$expr": "payload.key"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "dev-scanning",
      "module": "text",
      "props": {
        "size": 13,
        "color": "var(--u4-text-7)"
      },
      "bind": {
        "value": "conn.scanHint"
      },
      "when": "conn.scanHint"
    },
    {
      "id": "dev-scan-err",
      "module": "text",
      "props": {
        "size": 13,
        "color": "#ff9a8a"
      },
      "bind": {
        "value": "conn.scanError"
      },
      "when": "conn.scanError"
    },
    {
      "id": "dev-empty",
      "module": "text",
      "props": {
        "size": 13,
        "color": "var(--u4-text-7)"
      },
      "bind": {
        "value": "conn.emptyText"
      },
      "when": "conn.emptyText"
    },
    {
      "id": "manual-desk",
      "module": "manual-desk",
      "when": "conn.showManualDesk",
      "on": {
        "probe-desk": {
          "do": "ui.probeDesk",
          "args": {
            "ip": {
              "$expr": "payload.ip"
            }
          }
        }
      }
    },
    {
      "id": "offline",
      "module": "row",
      "props": {
        "align": "center",
        "gap": 14,
        "padding": "12px 14px",
        "radius": 3,
        "border": "1px dashed #2c3442",
        "background": "var(--u4-well-bg)",
        "box": "content-box"
      },
      "children": [
        {
          "id": "off-text",
          "module": "col",
          "props": {
            "flex": "1",
            "minWidth": 0,
            "box": "content-box"
          },
          "children": [
            {
              "id": "off-title",
              "module": "text",
              "props": {
                "value": "Offline editing",
                "size": 16,
                "weight": 600
              }
            },
            {
              "id": "off-sub",
              "module": "text",
              "props": {
                "value": "Prepare a show without a console. Changes sync when you connect.",
                "size": 13,
                "color": "var(--u4-text-7)"
              }
            }
          ]
        },
        {
          "id": "off-btn",
          "module": "btn",
          "props": {
            "label": "Work offline",
            "height": 44,
            "minWidth": 104,
            "fontSize": 14,
            "padding": "0 14px",
            "bg": "var(--u4-btn-bg)",
            "fg": "var(--u4-text-1)",
            "border": "1px solid var(--u4-line-ctl)",
            "bare": true
          },
          "on": {
            "press": {
              "do": "ui.goOffline"
            }
          }
        }
      ]
    }
  ]
}