{
  "id": "l0-demo-root",
  "module": "col",
  "props": { "gap": 8, "padding": 12, "width": "100%" },
  "children": [
    {
      "id": "title",
      "module": "text",
      "props": { "value": "L0 module demo", "size": 18, "weight": 600 }
    },
    {
      "id": "toolbar",
      "module": "row",
      "props": { "gap": 8, "height": 56 },
      "children": [
        { "id": "btn-a", "module": "button", "props": { "label": "Apply op", "variant": "primary" } },
        { "id": "tb-sp", "module": "spacer", "props": { "grow": true } },
        {
          "id": "seg-theme",
          "module": "segmented",
          "props": { "groupLabel": "Theme", "options": ["design-dark", "daylight", "night-red"], "selected": "design-dark" }
        }
      ]
    },
    {
      "id": "cards",
      "module": "grid",
      "props": { "columns": "1fr 1fr", "gap": 8 },
      "children": [
        {
          "id": "panel-a",
          "module": "panel",
          "props": { "title": "Panel A" },
          "children": [{ "id": "hello", "module": "text", "props": { "value": "hello", "size": 14 } }]
        },
        {
          "id": "strip-col",
          "module": "col",
          "props": { "gap": 4 },
          "children": [
            {
              "id": "rep",
              "module": "repeat",
              "props": { "over": "strips" },
              "children": [{ "id": "rep-t", "module": "text", "props": { "value": "strip {item}", "size": 12 } }]
            }
          ]
        }
      ]
    },
    {
      "id": "musician-only",
      "module": "text",
      "props": { "value": "musician note", "size": 12 },
      "when": { "role": "musician" }
    },
    {
      "id": "variant-note",
      "module": "text",
      "props": { "value": "desktop note", "size": 12 },
      "variants": { "phone": { "props": { "value": "phone note" } } }
    }
  ]
}
