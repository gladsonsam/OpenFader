{
  "id": "comp",
  "module": "col",
  "props": {
    "gap": 6,
    "flex": "1 1 auto",
    "box": "content-box"
  },
  "children": [
    {
      "id": "head",
      "module": "dyn-summary",
      "props": {
        "kind": "comp"
      },
      "bind": {
        "label": "dynLabel",
        "bg": "dynBg",
        "fg": "dynFg",
        "pressed": "dynPressed",
        "summary": "dynSummary"
      },
      "on": {
        "toggle": {
          "do": "ui.toggleDyn",
          "args": {
            "id": {
              "$expr": "selId"
            },
            "which": {
              "$expr": "dynKind"
            }
          }
        }
      },
      "when": "dynParams != null"
    },
    {
      "id": "body",
      "module": "row",
      "props": {
        "gap": 6,
        "wrap": true,
        "flex": "1 1 auto",
        "minHeight": 0,
        "box": "content-box"
      },
      "children": [
        {
          "id": "graph",
          "module": "dyn-transfer-graph",
          "props": {
            "kind": "comp",
            "color": "#ff9f43"
          },
          "on": {
            "thr": {
              "do": "channel.dynKnob",
              "args": {
                "id": { "$expr": "selId" },
                "which": { "$expr": "dynKind" },
                "prop": "thr",
                "value": { "$expr": "payload.value" },
                "locked": { "$expr": "store.locked" }
              }
            },
            "ratio": {
              "do": "channel.dynKnob",
              "args": {
                "id": { "$expr": "selId" },
                "which": { "$expr": "dynKind" },
                "prop": "ratio",
                "value": { "$expr": "payload.value" },
                "locked": { "$expr": "store.locked" }
              }
            },
            "makeup": {
              "do": "channel.dynKnob",
              "args": {
                "id": { "$expr": "selId" },
                "which": { "$expr": "dynKind" },
                "prop": "makeup",
                "value": { "$expr": "payload.value" },
                "locked": { "$expr": "store.locked" }
              }
            }
          },
          "bind": {
            "aria": "dynAria",
            "path": "dynPath",
            "fill": "dynFill",
            "fillColor": "dynFillColor",
            "thrX": "dynThrX",
            "thrLeft": "dynThrLeft",
            "thrText": "dynThrText",
            "grid": "dynGrid",
            "axis": "dynAxis",
            "params": "dynParams",
            "frozen": "frozen",
            "staticDotL": "dynDotL",
            "staticDotT": "dynDotT",
            "getLevel": "dynGetLevel"
          }
        },
        {
          "id": "knobs",
          "module": "dyn-knob-panel",
          "props": {
            "kind": "comp",
            "color": "#ff9f43",
            "size": 104
          },
          "variants": {
            "tablet": { "props": { "size": 88 } },
            "phone": { "props": { "size": 76 } }
          },
          "bind": {
            "knobs": "dynKnobs",
            "gate": "dynGate",
            "comp": "dynComp",
            "fine": "store.fine",
            "locked": "store.locked"
          },
          "on": {
            "knob": {
              "do": "channel.dynKnob",
              "args": {
                "id": {
                  "$expr": "selId"
                },
                "which": {
                  "$expr": "dynKind"
                },
                "prop": {
                  "$expr": "payload.prop"
                },
                "value": {
                  "$expr": "payload.value"
                },
                "locked": {
                  "$expr": "store.locked"
                }
              }
            }
          }
        }
      ],
      "when": "dynParams != null"
    },
    {
      "id": "dyn-empty",
      "module": "col",
      "props": {
        "flex": "1 1 auto",
        "align": "center",
        "justify": "center",
        "padding": 24,
        "radius": 3,
        "border": "1px solid var(--u4-line-panel)",
        "background": "var(--u4-well-bg)",
        "box": "content-box"
      },
      "when": "dynParams == null",
      "children": [
        {
          "id": "dyn-empty-text",
          "module": "text",
          "props": {
            "value": "No dynamics on this channel.",
            "size": 15,
            "color": "var(--u4-text-5)",
            "align": "center"
          }
        }
      ]
    }
  ]
}
