{
  "id": "strip",
  "module": "col",
  "props": {
    "gap": 3,
    "padding": 3,
    "background": "var(--u4-panel-bg)",
    "radius": 0,
    "minWidth": 0,
    "minHeight": 0,
    "flex": "1 1 auto",
    "selectable": true
  },
  "bind": {
    "shadow": "item.ring"
  },
  "on": {
    "select": {
      "do": "ui.select",
      "args": {
        "id": {
          "$expr": "item.id"
        }
      }
    }
  },
  "children": [
    {
      "id": "preamp",
      "module": "strip-preamp",
      "variants": {
        "phone": {
          "hidden": true
        }
      },
      "bind": {
        "input": "item.input",
        "name": "item.name"
      },
      "on": {
        "open": [
          {
            "do": "ui.select",
            "args": {
              "id": {
                "$expr": "item.id"
              }
            }
          },
          {
            "do": "ui.openPage",
            "args": {
              "mode": "channel"
            }
          },
          {
            "do": "ui.setTab",
            "args": {
              "tab": "input"
            }
          }
        ]
      }
    },
    {
      "id": "proc",
      "module": "col",
      "variants": {
        "phone": {
          "hidden": true
        }
      },
      "props": {
        "flex": "none",
        "gap": 3,
        "height": 102
      },
      "when": "(item.hasEq || item.hasDyn)",
      "children": [
        {
          "id": "eq-mini",
          "module": "strip-eq-mini",
          "bind": {
            "path": "item.eqPath",
            "stroke": "item.eqStroke",
            "ariaLabel": "item.eqAria"
          },
          "on": {
            "open": {
              "do": "ui.openEq",
              "args": {
                "id": {
                  "$expr": "item.id"
                }
              }
            }
          },
          "when": "item.hasEq"
        },
        {
          "id": "eq-mini-empty",
          "module": "col",
          "when": "!item.hasEq",
          "props": {
            "flex": "1 1 0",
            "minHeight": 0,
            "border": "1px solid var(--u4-line-faint)",
            "radius": 3,
            "background": "var(--u4-well-bg)"
          }
        },
        {
          "id": "dynamics-well",
          "module": "col",
          "props": {
            "height": 51,
            "flex": "none",
            "gap": 3,
            "padding": 4,
            "background": "var(--u4-well-bg)",
            "border": "1px solid var(--u4-line-panel)",
            "radius": 5
          },
          "children": [
            {
              "id": "gate-mini",
              "module": "strip-dyn-mini",
              "props": {
                "label": "Gate",
                "kind": "gate"
              },
              "bind": {
                "stripId": "item.id",
                "enabled": "item.gateOn",
                "ariaLabel": "concat('Open gate for ', item.name)"
              },
              "when": "item.hasGate",
              "on": {
                "open": [
                  {
                    "do": "ui.select",
                    "args": {
                      "id": {
                        "$expr": "item.id"
                      }
                    }
                  },
                  {
                    "do": "ui.openPage",
                    "args": {
                      "mode": "channel"
                    }
                  },
                  {
                    "do": "ui.setTab",
                    "args": {
                      "tab": "gate"
                    }
                  }
                ]
              }
            },
            {
              "id": "comp-mini",
              "module": "strip-dyn-mini",
              "props": {
                "label": "Compressor",
                "kind": "comp"
              },
              "bind": {
                "stripId": "item.id",
                "enabled": "item.compOn",
                "ariaLabel": "concat('Open compressor for ', item.name)"
              },
              "when": "item.hasComp",
              "on": {
                "open": [
                  {
                    "do": "ui.select",
                    "args": {
                      "id": {
                        "$expr": "item.id"
                      }
                    }
                  },
                  {
                    "do": "ui.openPage",
                    "args": {
                      "mode": "channel"
                    }
                  },
                  {
                    "do": "ui.setTab",
                    "args": {
                      "tab": "comp"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "proc-empty",
      "module": "strip-well-empty",
      "variants": {
        "phone": {
          "hidden": true
        }
      },
      "when": "!item.hasEq && !item.hasDyn"
    },
    {
      "id": "pan",
      "module": "strip-pan",
      "bind": {
        "value": "item.pan",
        "name": "item.name",
        "fine": "item.fine"
      },
      "on": {
        "input": {
          "do": "ui.setPan",
          "args": {
            "id": {
              "$expr": "item.id"
            },
            "value": {
              "$expr": "payload.value"
            }
          }
        }
      }
    },
    {
      "id": "mute",
      "module": "strip-mute",
      "props": {
        "height": 40
      },
      "variants": {
        "phone": {
          "props": {
            "height": 48
          }
        },
        "tablet": {
          "props": {
            "height": 48
          }
        }
      },
      "bind": {
        "muted": "item.muted",
        "known": "item.muteKnown",
        "enabled": "item.muteEnabled",
        "label": "concat('Mute ', item.name)"
      },
      "on": {
        "press": {
          "do": "ui.toggleMute",
          "args": {
            "id": {
              "$expr": "item.id"
            }
          }
        }
      }
    },
    {
      "id": "fader-area",
      "module": "col",
      "props": {
        "flex": "3 1 240px",
        "minHeight": 180
      },
      "variants": {
        "phone": {
          "props": {
            "flex": "5 1 320px",
            "minHeight": 240
          }
        }
      },
      "children": [
        {
          "id": "fader",
          "module": "strip-fader",
          "props": {
            "variant": "strip"
          },
          "bind": {
            "value": "item.value",
            "dbText": "item.readout",
            "ariaLabel": "item.faderAria",
            "accent": "item.useSend ? 'sof' : 'chan'",
            "readColor": "item.readColor",
            "fine": "item.fine",
            "meter": "item.meter",
            "meterFrozen": "frozen"
          },
          "on": {
            "input": {
              "do": "ui.setStripFader",
              "args": {
                "id": {
                  "$expr": "item.id"
                },
                "value": {
                  "$expr": "payload.value"
                },
                "useSend": {
                  "$expr": "item.useSend"
                },
                "mix": {
                  "$expr": "store.mix"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "name-wrap",
      "module": "col",
      "props": {
        "position": "relative"
      },
      "children": [
        {
          "id": "name",
          "module": "strip-name",
          "when": "device != 'phone'",
          "variants": {
            "phone": {
              "hidden": true
            }
          },
          "props": {
            "variant": "strip"
          },
          "bind": {
            "name": "item.name",
            "sub": "item.sub",
            "color": "item.color",
            "text": "item.text",
            "icon": "item.icon",
            "selectAria": "item.selectAria"
          },
          "on": {
            "select": [
              {
                "do": "ui.select",
                "args": {
                  "id": {
                    "$expr": "item.id"
                  }
                }
              },
              {
                "do": "ui.openPage",
                "args": {
                  "mode": "channel"
                }
              }
            ]
          }
        },
        {
          "id": "strip-tag",
          "module": "strip-tag",
          "variants": {
            "desktop": {
              "hidden": true
            },
            "tablet": {
              "hidden": true
            },
            "phone": {
              "hidden": false
            }
          },
          "bind": {
            "name": "item.name",
            "sub": "item.sub",
            "color": "item.color",
            "text": "item.text",
            "icon": "item.icon",
            "selectAria": "item.selectAria"
          },
          "on": {
            "select": [
              {
                "do": "ui.select",
                "args": {
                  "id": {
                    "$expr": "item.id"
                  }
                }
              },
              {
                "do": "ui.openPage",
                "args": {
                  "mode": "channel"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
