{
  "id": "input",
  "module": "grid",
  "props": {
    "columns": "repeat(auto-fit, minmax(270px, 1fr))",
    "gap": 6,
    "box": "content-box"
  },
  "children": [
    {
      "id": "input-empty",
      "module": "col",
      "props": {
        "flex": "1",
        "align": "center",
        "justify": "center",
        "padding": 24,
        "radius": 3,
        "border": "1px solid #1f2836",
        "background": "#0a0f17",
        "box": "content-box"
      },
      "when": "!inputVm.hasInput",
      "children": [
        {
          "id": "input-empty-text",
          "module": "text",
          "props": {
            "value": "No preamp on this channel — its signal comes from inside the console.",
            "size": 15,
            "color": "#a7b1c0",
            "align": "center"
          }
        }
      ]
    },
    {
      "id": "preamp",
      "module": "input-preamp-card",
      "bind": {
        "vm": "inputVm",
        "fine": "store.fine"
      },
      "when": "inputVm.hasInput",
      "on": {
        "knob": {
          "do": "ui.setInputKnob",
          "args": {
            "id": {
              "$expr": "selId"
            },
            "key": {
              "$expr": "payload.key"
            },
            "value": {
              "$expr": "payload.value"
            }
          }
        },
        "phantom": {
          "do": "ui.togglePhantom",
          "args": {
            "id": {
              "$expr": "selId"
            }
          }
        },
        "invert": {
          "do": "ui.toggleInvert",
          "args": {
            "id": {
              "$expr": "selId"
            }
          }
        }
      }
    },
    {
      "id": "source",
      "module": "input-source-card",
      "bind": {
        "vm": "inputVm",
        "levelText": "levelText",
        "meter": "hbarMeter",
        "meterFrozen": "frozen"
      },
      "when": "inputVm.hasInput",
      "on": {
        "patch": {
          "do": "ui.goPatch",
          "args": {
            "id": {
              "$expr": "selId"
            }
          }
        }
      }
    },
    {
      "id": "delay",
      "module": "input-delay-card",
      "bind": {
        "vm": "inputVm",
        "fine": "store.fine"
      },
      "when": "inputVm.hasInput",
      "on": {
        "knob": {
          "do": "ui.setInputKnob",
          "args": {
            "id": {
              "$expr": "selId"
            },
            "key": {
              "$expr": "payload.key"
            },
            "value": {
              "$expr": "payload.value"
            }
          }
        },
        "toggle": {
          "do": "ui.toggleDelayOn",
          "args": {
            "id": {
              "$expr": "selId"
            }
          }
        }
      }
    }
  ]
}
