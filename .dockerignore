# Keep the Rust workspace and actual Flutter app sources/assets in the context.
# Exclude host build products so container stages produce their own artifacts.
target/
**/target/
dist/
.git/
.github/
apps/
scripts/
artifacts/
*.log
.DS_Store
**/.dart_tool/
**/build/
**/.flutter-plugins*
**/.symlinks/
app/**/Pods/
app/**/ephemeral/
app/design/
