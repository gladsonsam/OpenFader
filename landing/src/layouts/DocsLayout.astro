---
import Base from './Base.astro';
import '../styles/docs.css';
import { GROUPS, docHref, sortedDocs, type Doc } from '../lib/docs';

interface Props {
  title: string;
  description: string;
  current?: Doc;
}
const { title, description, current } = Astro.props;
const docs = await sortedDocs();
const index = current ? docs.findIndex((d) => d.id === current.id) : -1;
const prev = index > 0 ? docs[index - 1] : undefined;
const next = index >= 0 && index < docs.length - 1 ? docs[index + 1] : undefined;
---
<Base title={`${title} | OpenFader docs`} description={description}>
  <div class="wrap docs">
    <aside class="docs-nav">
      <details open id="docsNav">
        <summary>{current ? current.data.title : 'Docs'}</summary>
        <nav>
          <a href="/docs" class:list={{ active: !current }}>Overview</a>
          {GROUPS.map((group) => (
            <div class="docs-group">
              <p>{group}</p>
              {docs.filter((d) => d.data.group === group).map((d) => (
                <a href={docHref(d)} class:list={{ active: current?.id === d.id }}>{d.data.title}</a>
              ))}
            </div>
          ))}
        </nav>
      </details>
    </aside>
    <article class="docs-body">
      <h1>{title}</h1>
      <div class="prose">
        <slot />
      </div>
      {(prev || next) && (
        <nav class="pager">
          {prev ? <a href={docHref(prev)}><span>Previous</span>{prev.data.title}</a> : <span />}
          {next && <a class="pager-next" href={docHref(next)}><span>Next</span>{next.data.title}</a>}
        </nav>
      )}
    </article>
  </div>
</Base>
<script>
  const nav = document.getElementById('docsNav') as HTMLDetailsElement | null;
  if (nav && matchMedia('(max-width: 900px)').matches) nav.open = false;
  // Screenshots open full size in a new tab.
  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    const link = document.createElement('a');
    link.href = img.src;
    link.target = '_blank';
    link.rel = 'noopener';
    link.className = 'shot-link';
    img.replaceWith(link);
    link.append(img);
  });
</script>
