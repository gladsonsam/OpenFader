---
import Base from '../layouts/Base.astro';
import { matrix } from '../lib/integration-matrix';
const mixerModels = matrix.models.filter(m => m.scope === 'provider');
const brand = mixerModels.some(m => m.brand === 'Behringer') ? 'Behringer' : mixerModels[0].brand;
const families = [...new Set(mixerModels.filter(m => m.brand === brand).map(m => m.family))].sort();
const family = families.includes('X Air') ? 'X Air' : families[0];
const models = mixerModels.filter(m => m.brand === brand && m.family === family);
const indexed = new Map(matrix.cells.map(c => [c.id, c]));
const features = matrix.features.filter(f => f.scope === 'provider' && models.some(m => indexed.get(`${m.id}:${f.id}`)?.state !== 'unreviewed'));
---
<Base title="Mixer compatibility | OpenFader" description="Compare implemented OpenFader features by manufacturer, product family and mixer model.">
  <section class="wrap compatibility">
    <header class="compatibility-intro">
      <h1>Mixer compatibility</h1>
      <p>Find your mixer. Compare its features.</p>
    </header>
    <form class="compatibility-filters" onsubmit="return false">
      <label>Manufacturer<select id="manufacturer">{[...new Set(mixerModels.map(m => m.brand))].sort().map(b => <option selected={b === brand}>{b}</option>)}</select></label>
      <label>Product<select id="product">{families.map(f => <option selected={f === family}>{f}</option>)}</select></label>
      <label>Model<select id="model"><option value="">All models</option>{models.map(m => <option value={m.id}>{m.name}</option>)}</select></label>
    </form>
    <div class="comparison-heading"><div><p id="manufacturer-name">{brand}</p><h2 id="product-name">{family}</h2></div><label class="feature-search"><span class="sr-only">Find a feature</span><input id="feature-search" type="search" placeholder="Find a feature" /></label></div>
    <p id="comparison-note" class="comparison-note">Implemented features; device testing is shown per model.</p>
    <p id="result-count" class="sr-only" role="status"></p>
    <div class="matrix-scroll" tabindex="0" role="region" aria-label="Model feature comparison">
      <table><caption class="sr-only">Implemented features by model</caption><thead><tr><th scope="col">Feature</th>{models.map(m => <th scope="col">{m.name}<small>{m.status}</small></th>)}</tr></thead><tbody>
        {features.map(f => <tr><th scope="row">{f.label}</th>{models.map(m => { const c = indexed.get(`${m.id}:${f.id}`)!; return <td><button class:list={['feature-status', c.state]} data-cell={c.id}>{c.label}</button></td>; })}</tr>)}
      </tbody></table>
    </div>
    <p id="empty" hidden></p>
    <p class="setup-link"><a class="btn btn-quiet" href="/docs/mixers">Mixer setup guide</a></p>
  </section>
  <dialog id="cell-detail" aria-labelledby="detail-title"><button id="close-detail" class="close" aria-label="Close details">Close</button><p id="detail-model"></p><h2 id="detail-title"></h2><p id="detail-state"></p><p id="detail-description"></p></dialog>
  <script id="compatibility-data" type="application/json" set:html={JSON.stringify(matrix).replaceAll('<', '\\u003c')} />
</Base>
<script>
  import type { MatrixModel, MatrixFeature, MatrixCell } from '../lib/integration-matrix';
  const data: { models: MatrixModel[]; features: MatrixFeature[]; cells: MatrixCell[] } = JSON.parse(document.querySelector('#compatibility-data')!.textContent!);
  const byId = new Map(data.cells.map(c => [c.id, c]));
  const manufacturer = document.querySelector<HTMLSelectElement>('#manufacturer')!;
  const product = document.querySelector<HTMLSelectElement>('#product')!;
  const model = document.querySelector<HTMLSelectElement>('#model')!;
  const search = document.querySelector<HTMLInputElement>('#feature-search')!;
  const table = document.querySelector('.compatibility table')!;
  const dialog = document.querySelector<HTMLDialogElement>('#cell-detail')!;
  const params = new URLSearchParams(location.search);
  const descriptions: Record<string, string> = {
    unreviewed: 'Feature details are still being reviewed.',
    missing: 'This feature is not integrated for this model.',
    partial: 'Some functionality is implemented; integration is incomplete.',
    implemented: 'Implemented in the app. Device testing is shown with the model.',
    blocked: 'This feature is currently unavailable for this model.',
    verified: 'Verified for this model.',
    not_applicable: 'This feature does not apply to this model.',
  };
  function text(tag: string, value: string) { const e = document.createElement(tag); e.textContent = value; return e; }
  function modelsForProduct() { return data.models.filter(m => m.scope === 'provider' && m.brand === manufacturer.value && m.family === product.value); }
  function choices(select: HTMLSelectElement, entries: [string, string][], preferred: string) {
    select.replaceChildren(...entries.map(([label, value]) => new Option(label, value)));
    if (entries.some(([, value]) => value === preferred)) select.value = preferred;
  }
  function models(preferred = '') { choices(model, [['All models', ''], ...modelsForProduct().map(m => [m.name, m.id] as [string, string])], preferred); draw(); }
  function products(preferred = '', preferredModel = '') {
    const families = [...new Set(data.models.filter(m => m.scope === 'provider' && m.brand === manufacturer.value).map(m => m.family))].sort();
    choices(product, families.map(f => [f, f]), preferred); models(preferredModel);
  }
  function manufacturers(preferred = '', preferredProduct = '', preferredModel = '') {
    const brands = [...new Set(data.models.filter(m => m.scope === 'provider').map(m => m.brand))].sort();
    choices(manufacturer, brands.map(b => [b, b]), preferred); products(preferredProduct, preferredModel);
  }
  function draw() {
    const ms = modelsForProduct().filter(m => !model.value || m.id === model.value);
    const coming = ms.every(m => m.status === 'Planned' || m.status === 'Unsupported');
    // Unfinished audit tasks remain in the developer matrix. Publish reviewed
    // implementation and known gaps, without turning missing proof into failure.
    const fs = data.features.filter(f => f.scope === 'provider' && ms.some(m => byId.get(`${m.id}:${f.id}`)?.state !== 'unreviewed') && f.label.toLowerCase().includes(search.value.trim().toLowerCase()));
    const head = document.createElement('thead'), hr = document.createElement('tr');
    const corner = text('th', 'Feature'); corner.setAttribute('scope', 'col'); hr.append(corner);
    for (const m of ms) { const th = text('th', m.name); th.setAttribute('scope', 'col'); th.append(text('small', m.status)); hr.append(th); } head.append(hr);
    const body = document.createElement('tbody');
    for (const f of fs) {
      const row = document.createElement('tr'), name = text('th', f.label); name.setAttribute('scope', 'row'); row.append(name);
      for (const m of ms) { const c = byId.get(`${m.id}:${f.id}`)!; const td = document.createElement('td'), button = text('button', c.label); button.className = `feature-status ${c.state}`; button.dataset.cell = c.id; button.setAttribute('aria-label', `${m.name}, ${f.label}: ${c.label}`); td.append(button); row.append(td); } body.append(row);
    }
    const caption = text('caption', `${manufacturer.value} ${product.value}: implemented features by model`); caption.className = 'sr-only'; table.replaceChildren(caption, head, body);
    document.querySelector('#manufacturer-name')!.textContent = manufacturer.value;
    document.querySelector('#product-name')!.textContent = product.value;
    document.querySelector('#result-count')!.textContent = `${ms.length} models, ${coming ? 0 : fs.length} features`;
    const empty = document.querySelector<HTMLElement>('#empty')!;
    empty.hidden = fs.length > 0 && !coming;
    empty.textContent = coming ? (ms.every(m => m.status === 'Unsupported') ? 'This product is not supported.' : 'Integration is planned for this product.') : search.value ? 'No matching features. Try another search.' : 'Feature details are being prepared for this product.';
    document.querySelector<HTMLElement>('.matrix-scroll')!.hidden = !empty.hidden;
    document.querySelector<HTMLElement>('#comparison-note')!.hidden = coming;
    const url = new URL(location.href); url.search = '';
    url.searchParams.set('manufacturer', manufacturer.value); url.searchParams.set('product', product.value);
    if (model.value) url.searchParams.set('model', model.value);
    history.replaceState(null, '', url);
  }
  table.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-cell]'); if (!button) return;
    const c = byId.get(button.dataset.cell!)!, m = data.models.find(m => m.id === c.model)!, f = data.features.find(f => f.id === c.feature)!;
    document.querySelector('#detail-model')!.textContent = `${m.brand} ${m.name}`;
    document.querySelector('#detail-title')!.textContent = f.label;
    document.querySelector('#detail-state')!.textContent = c.label;
    document.querySelector('#detail-description')!.textContent = c.note || descriptions[c.state]; dialog.showModal();
  });
  document.querySelector('#close-detail')!.addEventListener('click', () => dialog.close());
  manufacturer.addEventListener('change', () => products());
  product.addEventListener('change', () => models());
  model.addEventListener('change', draw); search.addEventListener('input', draw);
  manufacturers(params.get('manufacturer') || 'Behringer', params.get('product') || 'X Air', params.get('model') || '');
</script>
<style is:global>
  .compatibility { padding-top: 40px; }
  .compatibility-intro { margin-bottom: 24px; }
  .compatibility-intro h1 { font-size: clamp(44px, 6vw, 64px); }
  .compatibility-intro p { font-size: 22px; margin: 12px 0 0; }
  .compatibility-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; max-width: 960px; }
  .compatibility label { display: grid; gap: 8px; font-size: 14px; color: var(--muted); }
  .compatibility input, .compatibility select { min-width: 0; width: 100%; font: inherit; font-size: 16px; color: var(--text); background: var(--bg); padding: 12px; border: 1px solid var(--line); border-radius: 6px; }
  .compatibility input:focus-visible, .compatibility select:focus-visible, .compatibility button:focus-visible, .matrix-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .comparison-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-top: 28px; }
  .comparison-heading h2 { font-size: 36px; }
  #manufacturer-name { font-size: 15px; color: var(--muted); margin: 0 0 4px; }
  .feature-search { width: 220px; }
  .comparison-note { margin: 14px 0 20px; color: var(--muted); font-size: 14px; }
  .matrix-scroll { overflow: auto; max-height: 680px; border: 1px solid var(--line); margin-top: 20px; }
  .compatibility table { border-spacing: 0; width: 100%; font-size: 15px; }
  .compatibility th, .compatibility td { border-bottom: 1px solid var(--line); text-align: left; padding: 16px 20px; min-width: 150px; }
  .compatibility thead th { position: sticky; top: 0; background: var(--bg); z-index: 2; font-size: 21px; font-weight: 500; border-bottom-color: var(--muted); }
  .compatibility thead th small { display: block; font-size: 13px; font-weight: 400; color: var(--muted); margin-top: 5px; }
  .compatibility tr > th:first-child { position: sticky; left: 0; min-width: 210px; background: var(--bg); z-index: 1; font-size: 15px; font-weight: 400; }
  .compatibility thead tr > th:first-child { z-index: 3; }
  .feature-status { --status-color: var(--muted); font: inherit; font-size: 14px; font-weight: 500; color: var(--status-color); background: color-mix(in srgb, var(--status-color) 8%, var(--bg)); border: 1px solid color-mix(in srgb, var(--status-color) 30%, var(--bg)); border-radius: 6px; padding: 8px 12px; min-width: 128px; min-height: 40px; text-align: center; cursor: pointer; }
  .feature-status:hover { background: color-mix(in srgb, var(--status-color) 16%, var(--bg)); border-color: var(--status-color); }
  .feature-status.implemented, .feature-status.verified { --status-color: var(--accent); }
  .feature-status.partial { --status-color: #e6b77b; }
  #cell-detail { background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 12px; padding: 28px; width: min(560px, calc(100% - 32px)); max-height: 85svh; }
  #cell-detail::backdrop { background: #000b; }
  #cell-detail h2 { font-size: 32px; }
  #detail-model { color: var(--muted); margin-top: 0; }
  #detail-state { color: var(--accent); }
  .close { float: right; font: inherit; background: transparent; color: var(--text); border: 1px solid var(--line); padding: 6px 12px; border-radius: 6px; cursor: pointer; }
  .setup-link { margin-top: 28px; font-size: 15px; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media(max-width: 600px) { .compatibility { padding-top: 32px; } .compatibility-intro { margin-bottom: 24px; } .compatibility-intro p { font-size: 18px; } .compatibility-filters { grid-template-columns: 1fr 1fr; gap: 16px 12px; } .compatibility-filters label:last-child { grid-column: 1 / -1; } .comparison-heading { display: block; margin-top: 28px; } .feature-search { width: 100%; margin-top: 18px; } .compatibility th, .compatibility td { padding: 14px 16px; min-width: 132px; } .compatibility tr > th:first-child { min-width: 150px; max-width: 150px; } .compatibility thead th { font-size: 19px; } }
</style>
