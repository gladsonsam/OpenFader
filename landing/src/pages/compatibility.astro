---
import Base from '../layouts/Base.astro';
import { matrix } from '../lib/integration-matrix';
const features = matrix.features.filter(f => f.scope === 'provider');
const models = matrix.models.filter(m => m.scope === 'provider');
const indexed = new Map(matrix.cells.map(c => [c.id, c]));
---
<Base title="Mixer compatibility | OpenFader" description="Explore OpenFader integration coverage by mixer brand, model and feature, with separate implementation and verification status.">
  <section class="wrap compatibility">
    <header class="intro">
      <h1>Mixer compatibility</h1>
      <p>Explore each model, feature by feature.</p>
    </header>
    <form class="filters" onsubmit="return false">
      <label>Find a model<input id="model-search" type="search" placeholder="e.g. DL32S, X32, Midas" /></label>
      <label>Brand<select id="brand-filter"><option value="">All brands</option>{[...new Set(models.map(m => m.brand))].sort().map(b => <option>{b}</option>)}</select></label>
      <label>Feature<select id="feature-filter"><option value="">All features</option>{features.map(f => <option value={f.id}>{f.label}</option>)}</select></label>
      <label>View<select id="scope-filter"><option value="provider">Mixer models</option><option value="host">Recorder platforms</option></select></label>
    </form>
    <div class="table-note"><p id="result-count" role="status">{models.length} models</p><span>Select a status for details</span></div>
    <div class="matrix-scroll" tabindex="0" role="region" aria-label="Feature comparison; scroll horizontally to compare more features">
      <table><caption class="sr-only">OpenFader feature integration by exact mixer model</caption><thead><tr><th scope="col">Brand / model</th>{features.map(f => <th scope="col">{f.label}</th>)}</tr></thead><tbody>
        {models.map(m => <tr><th scope="row"><span>{m.brand}</span>{m.name}</th>{features.map(f => { const c = indexed.get(`${m.id}:${f.id}`)!; return <td><button data-cell={c.id} class:list={['cell', c.state]}>{c.label}</button></td>; })}</tr>)}
      </tbody></table>
    </div>
    <p id="empty" hidden>No matching models. Try another name or reset the brand filter.</p>
    <p class="setup-link"><a href="/docs/mixers">Mixer setup guide</a></p>
  </section>
  <dialog id="cell-detail" aria-labelledby="detail-title"><button id="close-detail" class="close" aria-label="Close details">Close</button><p id="detail-model"></p><h2 id="detail-title"></h2><p id="detail-state"></p><p id="detail-description"></p></dialog>
  <script id="compatibility-data" type="application/json" set:html={JSON.stringify(matrix).replaceAll('<', '\\u003c')} />
</Base>
<script>
  import type { MatrixModel, MatrixFeature, MatrixCell } from '../lib/integration-matrix';
  const data: {models: MatrixModel[]; features: MatrixFeature[]; cells: MatrixCell[]} = JSON.parse(document.querySelector('#compatibility-data')!.textContent!);
  const byId = new Map(data.cells.map(c => [c.id, c]));
  const search = document.querySelector<HTMLInputElement>('#model-search')!;
  const brand = document.querySelector<HTMLSelectElement>('#brand-filter')!;
  const feature = document.querySelector<HTMLSelectElement>('#feature-filter')!;
  const scope = document.querySelector<HTMLSelectElement>('#scope-filter')!;
  const table = document.querySelector('table')!;
  const dialog = document.querySelector<HTMLDialogElement>('#cell-detail')!;
  const descriptions: Record<string, string> = {
    unreviewed: 'This feature has not been reviewed yet.',
    missing: 'This feature needs integration for this model.', partial: 'Some functionality is available; integration is incomplete.',
    implemented: 'Implemented, with verification still pending.',
    blocked: 'Integration or verification cannot proceed yet.',
    verified: 'Verified for this model.',
    not_applicable: 'This feature does not apply to this model.',
  };
  function text(tag: string, value: string) { const e = document.createElement(tag); e.textContent = value; return e; }
  function draw() {
    const fs = data.features.filter(f => f.scope === scope.value && (!feature.value || f.id === feature.value));
    const ms = data.models.filter(m => m.scope === scope.value && (!brand.value || m.brand === brand.value) && `${m.brand} ${m.family} ${m.name}`.toLowerCase().includes(search.value.trim().toLowerCase()));
    const head = document.createElement('thead'), hr = document.createElement('tr');
    const corner = text('th', 'Brand / model'); corner.setAttribute('scope', 'col'); hr.append(corner);
    for (const f of fs) { const th = text('th', f.label); th.setAttribute('scope', 'col'); hr.append(th); } head.append(hr);
    const body = document.createElement('tbody');
    for (const m of ms) {
      const row = document.createElement('tr'), name = document.createElement('th'); name.setAttribute('scope', 'row');
      name.append(text('span', m.brand), document.createTextNode(m.name)); row.append(name);
      for (const f of fs) { const c = byId.get(`${m.id}:${f.id}`)!; const td = document.createElement('td'), button = text('button', c.label); button.className = `cell ${c.state}`; button.dataset.cell = c.id; button.setAttribute('aria-label', `${m.brand} ${m.name}, ${f.label}: ${c.label}`); td.append(button); row.append(td); } body.append(row);
    }
    const caption = text('caption', 'OpenFader feature integration by exact model'); caption.className = 'sr-only'; table.replaceChildren(caption, head, body);
    document.querySelector('#result-count')!.textContent = `${ms.length} ${scope.value === 'host' ? 'platforms' : 'models'} / ${fs.length} features`;
    document.querySelector<HTMLElement>('#empty')!.hidden = ms.length > 0;
  }
  function options() {
    brand.replaceChildren(new Option('All brands', ''), ...[...new Set(data.models.filter(m => m.scope === scope.value).map(m => m.brand))].sort().map(b => new Option(b, b)));
    feature.replaceChildren(new Option('All features', ''), ...data.features.filter(f => f.scope === scope.value).map(f => new Option(f.label, f.id)));
    draw();
  }
  table.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-cell]'); if (!button) return;
    const c = byId.get(button.dataset.cell!)!, m = data.models.find(m => m.id === c.model)!, f = data.features.find(f => f.id === c.feature)!;
    document.querySelector('#detail-model')!.textContent = `${m.brand} ${m.name}`;
    document.querySelector('#detail-title')!.textContent = f.label;
    document.querySelector('#detail-state')!.textContent = c.label;
    document.querySelector('#detail-description')!.textContent = descriptions[c.state];
    dialog.showModal();
  });
  document.querySelector('#close-detail')!.addEventListener('click', () => dialog.close());
  for (const e of [search, brand, feature]) e.addEventListener('input', draw);
  scope.addEventListener('change', options); draw();
</script>
<style is:global>
  .compatibility { padding-top: 64px; }
  .intro { max-width: 800px; margin-bottom: 40px; }
  .intro h1 { font-size: clamp(44px, 6vw, 76px); }
  .intro > p:not(.note) { font-size: 24px; margin: 16px 0; }
  .filters { display: grid; grid-template-columns: 2fr 1fr 1.4fr 1fr; gap: 20px; margin-bottom: 24px; }
  .compatibility label { display: grid; gap: 8px; font-size: 14px; color: var(--muted); }
  .compatibility input, .compatibility select { min-width: 0; width: 100%; font: inherit; font-size: 16px; color: var(--text); background: var(--bg); padding: 12px; border: 1px solid var(--line); border-radius: 6px; }
   .compatibility input:focus-visible, .compatibility select:focus-visible, .compatibility button:focus-visible, .matrix-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .table-note { display: flex; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 14px; margin-bottom: 12px; }
  .table-note p { margin: 0; color: var(--text); }
  .matrix-scroll { overflow: auto; max-height: 640px; border: 1px solid var(--line); }
  .compatibility table { border-spacing: 0; width: 100%; font-size: 14px; }
  .compatibility th, .compatibility td { border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); text-align: left; padding: 16px; min-width: 160px; }
  .compatibility thead th { position: sticky; top: 0; background: var(--bg); z-index: 2; font-weight: 500; }
  .compatibility tr > th:first-child { position: sticky; left: 0; min-width: 210px; background: var(--bg); z-index: 1; font-size: 20px; font-weight: 500; }
  .compatibility thead tr > th:first-child { z-index: 3; font-size: 14px; }
  .compatibility tbody th span, .compatibility tbody th small { display: block; font-size: 12px; font-weight: 400; color: var(--muted); }
  .compatibility tbody th small { margin-top: 5px; }
  .cell { font: inherit; color: var(--muted); background: transparent; border: 0; padding: 8px 0; text-align: left; cursor: pointer; width: 100%; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 5px; }
  .cell:hover { color: var(--text); }
  .cell.partial, .cell.missing, .cell.blocked { color: #e6b77b; }
  .cell.verified { color: var(--accent); }
  #cell-detail { background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 12px; padding: 28px; width: min(560px, calc(100% - 32px)); max-height: 85svh; }
  #cell-detail::backdrop { background: #000b; }
  #cell-detail h2 { font-size: 32px; }
  #cell-detail p, #cell-detail li { max-width: 65ch; }
  #detail-model { color: var(--muted); margin-top: 0; }
  #detail-state { color: var(--accent); }
  .close { float: right; font: inherit; background: transparent; color: var(--text); border: 1px solid var(--line); padding: 6px 12px; border-radius: 6px; cursor: pointer; }
  .setup-link { margin-top: 28px; font-size: 15px; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media(max-width: 800px) { .filters { grid-template-columns: 1fr 1fr; } }
  @media(max-width: 600px) { .compatibility { padding-top: 36px; } .intro { margin-bottom: 28px; } .intro > p:not(.note) { font-size: 20px; } .filters { gap: 16px 12px; } .filters label:first-child { grid-column: 1 / -1; } .table-note { display: block; } .table-note span { display: block; margin-top: 6px; } .compatibility tr > th:first-child { min-width: 142px; max-width: 142px; font-size: 18px; } .compatibility th, .compatibility td { padding: 12px; min-width: 145px; } }
</style>
