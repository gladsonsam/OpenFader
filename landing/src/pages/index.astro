---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Mixers from '../components/Mixers.astro';
import WhyOpenFader from '../components/WhyOpenFader.astro';
import Download from '../components/Download.astro';
import { TAGLINE, DESCRIPTION } from '../brand';

const title = `OpenFader | ${TAGLINE}`;
const description = `${TAGLINE}. ${DESCRIPTION}`;
---
<Base title={title} description={description}>
  <Hero />
  <Features />
  <Mixers />
  <WhyOpenFader />
  <Download />
</Base>
