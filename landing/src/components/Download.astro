---
import { REPO, RELEASES } from '../links';
---
<section class="wrap section download" id="download">
  <h2>Download</h2>
  <p class="lede">Free and open source. Runs on iPhone, iPad, Android, Mac, Windows and Linux.</p>
  <div class="actions">
    <a class="btn btn-solid btn-lg" href={RELEASES}>Download</a>
    <a class="btn btn-quiet btn-lg" href={REPO}>View source</a>
  </div>
  <p class="note">No mixer? Choose Work offline to try the app.</p>
</section>
