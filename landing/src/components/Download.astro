---
import { RELEASES } from '../links';
---
<section class="wrap section download" id="download" aria-labelledby="download-heading">
  <div class="download-content">
    <h2 id="download-heading">Get OpenFader</h2>
    <p class="lede">Free and open source.</p>
    <div class="actions">
      <a class="btn btn-solid btn-lg" href={RELEASES}>Download OpenFader</a>
      <a class="download-guide" href="/docs/getting-started">Installation guide</a>
    </div>
    <p class="note">Try it without a mixer. Choose Work offline when you open the app.</p>
  </div>
  <div class="download-platforms">
    <div>
      <h3>Phones and tablets</h3>
      <p>iPhone, iPad and Android</p>
    </div>
    <div>
      <h3>Computers</h3>
      <p>Mac, Windows and Linux</p>
    </div>
  </div>
</section>
